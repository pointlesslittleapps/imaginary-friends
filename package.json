{
  "name": "diary-app",
  "version": "1.0.0",
  "description": "Local diary app with AI agent",
  "main": "public/main.cjs",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "electron": "electron .",
    "dev": "concurrently -k \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "rebuild-native": "electron-rebuild -f -w sqlite3",
    "dist": "npm run build && npm run rebuild-native && electron-builder --mac --publish never",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "electron-is-dev": "^3.0.1",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "react-scripts": "^5.0.1",
    "wait-on": "^7.0.1"
  },
  "build": {
    "extends": null,
    "appId": "com.local.imaginaryfriends",
    "productName": "Imaginary Friends",
    "files": [
      "build/**/*",
      "public/main.cjs",
      "public/preload.cjs",
      "src/api/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.lifestyle"
    }
  }
}
